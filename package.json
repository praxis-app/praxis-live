{
  "name": "praxis-live",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "types": "tsc -b",
    "lint": "eslint .",
    "check": "npm run types && npm run lint && npm audit",
    "cli": "node ./cli/praxis-cli.mjs",
    "preview": "vite preview",
    "test:api:integration": "cargo test -p api --test http_routes --",
    "test:e2e": "tsx ./e2e/run-e2e.ts",
    "test:e2e:headed": "PLAYWRIGHT_SLOW_MO=500 tsx ./e2e/run-e2e.ts --headed",
    "test:e2e:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@hookform/resolvers": "^5.2.2",
