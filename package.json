    "eslint-plugin-react-refresh": "^0.4.24",
    "fallow": "^2.54.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
